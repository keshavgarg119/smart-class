<project name="TestNGReport" default="generate-report" basedir=".">

    <target name="generate-report">
        <!-- Generate custom report using XSLT -->
        <xslt in="testng-results.xml"
              style="reports.xsl"
              out="custom-report.html"/>
        
        <!-- Copy standard reports from target (if they exist) -->
        <copy todir="." failonerror="false">
            <fileset dir="../target/surefire-reports">
                <include name="emailable-report.html"/>
                <include name="index.html"/>
                <include name="testng-reports.css"/>
                <include name="testng-reports.js"/>
            </fileset>
        </copy>
    </target>

</project>