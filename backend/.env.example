# Application Settings
APP_NAME=Smart Attendance System
DEBUG=True

# Database Configuration
# Replace <username>, <password>, and <cluster> with your own MongoDB Atlas credentials
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_attendance?retryWrites=true&w=majority

# Security Settings
SECRET_KEY=your-secret-key-change-this-in-production-use-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Face Recognition Settings
FACE_ENCODINGS_DIR=./face_encodings
FACE_RECOGNITION_TOLERANCE=0.6

# SMTP Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@thapar.edu
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@thapar.edu
